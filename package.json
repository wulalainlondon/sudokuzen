{
  "name": "sudoku-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "build:teach": "node scripts/build-teach.mjs",
    "build:data": "node scripts/build-data.mjs",
    "validate:teach": "node scripts/validate-teach-data.mjs",
    "dev": "npm run sync:version && vite",
    "build": "npm run sync:version && npm run validate:teach && npm run build:teach && npm run build:data && vite build",
    "build:firebase": "DEPLOY_TARGET=firebase npm run build && node scripts/prepare-pages-dist.mjs && node scripts/smoke-test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "perf:check": "node scripts/perf-budget.mjs",
    "release:check": "node scripts/release-check.mjs && npm run perf:check",
    "release:check:live": "node scripts/release-check.mjs --live && npm run perf:check",
    "deploy:preview": "npm run build:firebase && npx firebase hosting:channel:deploy web-preview --project sudokuzen-f2aa3",
    "deploy:live": "npm run build:firebase && npx firebase deploy --only hosting --project sudokuzen-f2aa3",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "test": "npm run sync:version && vitest run",
    "test:e2e": "npx playwright test",
    "test:e2e:smoke": "npx playwright test e2e/level-navigation.spec.ts e2e/single-player-full-run.spec.ts e2e/speedrun-mode.spec.ts e2e/offline-sw.spec.ts e2e/wild-mode.spec.ts",
    "test:e2e:solo": "npx playwright test e2e/single-player-full-run.spec.ts",
    "test:e2e:duo": "npx playwright test e2e/duo-sync.spec.ts",
    "test:e2e:duo-live": "npx playwright test --config playwright.live.config.ts",
    "test:e2e:replay": "npx playwright test e2e/replay-end-to-end.spec.ts",
    "check": "npm run validate:teach && npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  }
}
