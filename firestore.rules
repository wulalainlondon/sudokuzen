rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validAlias(name) {
      return name is string
        && name.size() >= 1
        && name.size() <= 24
        && name.matches('^[^<>&"\\\']+$');
    }

    match /level_first_clears/{levelId}/players/{playerId} {
      allow read: if true;
      allow create: if request.resource.data.playerId == playerId
                    && request.resource.data.firstTimeSec is int
                    && request.resource.data.firstStars is int
                    && validAlias(request.resource.data.alias);
      allow update, delete: if false;
    }

    // Duo multi-room model (v2: tier/mode/seed).
    match /duo_rooms/{roomId} {
      function validDuoFields() {
        return request.resource.data.levelId is int
            && request.resource.data.status in ['idle', 'waiting', 'countdown', 'playing', 'finished']
            && request.resource.data.hostId is string
            && validAlias(request.resource.data.hostAlias)
            && (request.resource.data.guestId == null || request.resource.data.guestId is string)
            && (request.resource.data.guestAlias == null || validAlias(request.resource.data.guestAlias))
            && (request.resource.data.hostReady is bool)
            && (request.resource.data.guestReady is bool)
            && (request.resource.data.hostProgress is number)
            && (request.resource.data.guestProgress is number)
            && (request.resource.data.hostFinishTime == null || request.resource.data.hostFinishTime is int)
            && (request.resource.data.guestFinishTime == null || request.resource.data.guestFinishTime is int)
            && (request.resource.data.levelLocked == null || request.resource.data.levelLocked is bool)
            && (request.resource.data.hostHeartbeatAtMs == null || request.resource.data.hostHeartbeatAtMs is number)
            && (request.resource.data.guestHeartbeatAtMs == null || request.resource.data.guestHeartbeatAtMs is number)
            && (request.resource.data.hostOnline == null || request.resource.data.hostOnline is bool)
            && (request.resource.data.guestOnline == null || request.resource.data.guestOnline is bool)
            && (request.resource.data.tierId == null || request.resource.data.tierId is string)
            && (request.resource.data.modeId == null || request.resource.data.modeId is string)
            && (request.resource.data.puzzleSeed == null || request.resource.data.puzzleSeed is int)
            && (request.resource.data.specBoardState == null || request.resource.data.specBoardState is string)
            && (request.resource.data.specBoardVersion == null || request.resource.data.specBoardVersion is int)
            && (request.resource.data.specBombAt == null || request.resource.data.specBombAt is int)
            && (request.resource.data.specBombCells == null || request.resource.data.specBombCells is list);
      }
      allow read: if true;
      allow create: if false; // All room creation must go through Cloud Functions
      allow update: if request.auth != null
                    && (
                      request.auth.uid == resource.data.hostId
                      || request.auth.uid == resource.data.guestId
                      || (resource.data.guestId == null && resource.data.status == 'waiting')
                    )
                    && validDuoFields()
                    // Phase 1+3+4: finishTime/stars/status/ready/countdown 只能透過 Cloud Functions 寫入
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasAny([
                           'hostFinishTime', 'guestFinishTime', 'hostStars', 'guestStars',
                           'status', 'hostReady', 'guestReady', 'countdownStartedAt', 'startAt',
                           'guestId', 'guestAlias', 'guestTitle', 'guestDuoWins',
                           'specBombAt', 'specBombCells'
                         ]);
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.hostId;
    }

    // Lightweight online presence.
    match /presence/{playerId} {
      allow read: if true;
      allow create, update: if request.resource.data.playerId is string
                            && request.resource.data.playerId == playerId;
      allow delete: if true;
    }

    // Player profile (achievements cloud sync)
    match /player_profiles/{playerId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.playerId == playerId
                            && validAlias(request.resource.data.alias)
                            && request.resource.data.achievements is map
                            && request.resource.data.achievements.size() <= 200;
      allow delete: if false;

      match /game_saves/{saveKey} {
        allow get, list: if true;
        allow create, update: if request.resource.data.playerId == playerId
                              && request.resource.data.key is string
                              && request.resource.data.key == saveKey
                              && request.resource.data.payload is map;
        allow delete: if resource.data.playerId == playerId;
      }
    }

    match /alias_player_index/{aliasKey} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.aliasKey is string
                            && request.resource.data.aliasKey == aliasKey
                            && request.resource.data.aliasDisplay is string
                            && request.resource.data.aliasDisplay.size() >= 1
                            && request.resource.data.aliasDisplay.size() <= 24
                            && request.resource.data.playerId is string
                            && request.resource.data.playerId.size() >= 8
                            && request.resource.data.playerId.size() <= 64;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
