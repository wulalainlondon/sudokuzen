rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /level_first_clears/{levelId}/players/{playerId} {
      allow read: if true;
      allow create: if request.resource.data.playerId == playerId
                    && request.resource.data.firstTimeSec is int
                    && request.resource.data.firstStars is int
                    && request.resource.data.alias is string
                    && request.resource.data.alias.size() >= 1
                    && request.resource.data.alias.size() <= 24;
      allow update, delete: if false;
    }

    // Duo room minimal hardening for current architecture:
    // only the fixed room doc is writable and key fields must be typed.
    match /duo_room/current {
      allow read: if true;
      allow write: if request.resource.data.levelId is int
                   && request.resource.data.status is string
                   && request.resource.data.hostId is string
                   && (request.resource.data.guestId == null || request.resource.data.guestId is string);
    }

    // Player profile (achievements cloud sync)
    match /player_profiles/{playerId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.playerId == playerId
                            && request.resource.data.alias is string
                            && request.resource.data.alias.size() >= 1
                            && request.resource.data.alias.size() <= 24
                            && request.resource.data.achievements is map
                            && request.resource.data.achievements.size() <= 200;
      allow delete: if false;

      match /game_saves/{saveKey} {
        allow get: if true;
        allow list: if false;
        allow create, update: if request.resource.data.playerId == playerId
                              && request.resource.data.key is string
                              && request.resource.data.key == saveKey
                              && request.resource.data.payload is map;
        allow delete: if resource.data.playerId == playerId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
